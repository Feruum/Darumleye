# Local web, API, and agent ports
PORT=3000
VITE_API_URL=http://localhost:3000
PUBLIC_WEBAPP_URL=http://localhost:5173
POSTGRES_PORT=54329
CHROMA_PORT=8000
AGENT_PORT=8001
AGENT_SERVICE_URL=http://127.0.0.1:8001

# Local PostgreSQL account database. Drizzle applies the migrations on `bun run dev`.
DATABASE_URL=postgresql://superuser:superpassword@localhost:54329/web_app_demo
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBAPP_ORIGIN=http://localhost:5173

# Bun-to-agent secret. Keep this a local-only placeholder and change it before sharing a network.
AGENT_API_KEY=local-agent-dev-key-change-before-sharing

# Supply the matching gateway key to enable reviews.
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=
# New uploads default to multi_agent. Use multi_agent_direct for direct validation or legacy for classic review.
# Shared reasoning effort for main review stages; adjudication has its own setting.
AGENT_LLM_MODEL=openai/gpt-6-luna
AGENT_SPEC_REVIEW_REASONING_EFFORT=low
AGENT_SPEC_REVIEW_ADJUDICATION_REASONING_EFFORT=auto
AGENT_SPEC_REVIEW_FACT_PROFILE=full
AGENT_SPEC_REVIEW_USE_Z3=true
AGENT_LLM_TIMEOUT_SECONDS=45
AGENT_LLM_MAX_RETRIES=2
AGENT_SPEC_REVIEW_TIMEOUT_SECONDS=230
AGENT_SPEC_REVIEW_LARGE_TIMEOUT_SECONDS=900
# Maximum simultaneous primary model calls per review.
AGENT_SPEC_REVIEW_CONCURRENCY=9
AGENT_SPEC_REVIEW_USE_NACE=false

# OpenAI-compatible embedding endpoint. Blank values reuse the chat endpoint and API key.
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=

# Reranking is optional and disabled by default.
AGENT_USE_RERANKER=false
AGENT_RERANK_PROVIDER=nace
NACE_API_KEY=
AGENT_NACE_MODEL=drex-latest
AGENT_NACE_TIMEOUT_SECONDS=8
AGENT_USE_HYBRID_SEARCH=true
AGENT_RETRIEVAL_LEXICAL_MAX_CHUNKS=2000

# Optional Langfuse. Leave all three blank to disable review telemetry.
# For local containers use http://langfuse-web:3000; CLI uses http://localhost:3333.
AGENT_LANGFUSE_BASE_URL=
AGENT_LANGFUSE_PUBLIC_KEY=
AGENT_LANGFUSE_SECRET_KEY=
# Python SDK v5 requires Langfuse server >=4.59.0.
LANGFUSE_IMAGE_TAG=4.86.0
LANGFUSE_PORT=3333
LANGFUSE_ALERT_INTERVAL_SECONDS=300
# Set distinct random credentials before starting the optional langfuse profile.
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=  # 64 hexadecimal characters
# LANGFUSE_NEXTAUTH_SECRET=
