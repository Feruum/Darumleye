digraph ReviewPipeline {
  graph [rankdir=TB, bgcolor="#ffffff", margin=0.2, pad=0.25, nodesep=0.26, ranksep=0.34, splines=polyline, fontname="DejaVu Sans", label="DARUMLEYE  /  AI-пайплайн Spec Review", labelloc=t, fontsize=22, fontcolor="#29213d"];
  node [shape=box, style="rounded,filled", color="#b7aacd", fillcolor="#f8f6fc", fontcolor="#29213d", penwidth=1.3, fontname="DejaVu Sans", fontsize=12, margin="0.20,0.10"];
  edge [color="#675a80", fontname="DejaVu Sans", fontsize=10, fontcolor="#514665", arrowsize=0.7];
  Input [shape=oval, label="ТЗ + выбранные регламенты (опц.)", fillcolor="#eae1fb"];
  Parse [label="Валидация · PDF / MD / TXT / Office / CSV / изображения\nOCR · исходные координаты · SHA-256"];
  Register [label="Извлечение по всем диапазонам\nВалидированный реестр R-ID", fillcolor="#eae1fb", color="#8e70c6"];
  Input -> Parse -> Register;
  subgraph cluster_core { label="CORE REVIEW  ·  Полное покрытие документа"; style="rounded"; color="#9b83cb"; fontname="DejaVu Sans"; fontsize=12; labelloc=t;
    Static [label="Детерминированные проверки\nID, повтор, пустое поле, диапазон"];
    Facts [label="Fact / Clause Index\nZ3: ограниченные свидетели (опц.)",fillcolor="#eef6f0",color="#88b29a"];
    Legacy [label="Legacy\nИндивидуальные + whole set"];
    Experts [label="5 независимых экспертов\nLogic · Scenario · Gap · Contract · Risk"];
    Pair [label="3 парных валидатора\nDefault: multi_agent"];
    Direct [label="Прямая валидация\nmulti_agent_direct"];
    Global [label="Общий валидатор\nПроверка критериев и источников"];
    Final [label="Finalizer\nКонсолидация общих причин"];
    Arbiter [label="Арбитр фактов и критичности\nПодтверждение / отклонение / uncertainty",fillcolor="#eae1fb",color="#8e70c6"];
    Recheck [label="Адресная перепроверка\nТребование × критерий"];
    Verify [label="Проверенные доказательства\n9 на R-ID + 6 набора + 15 readiness",fillcolor="#ece4fc",color="#8e70c6"];
    Quarantine [label="Отклонённые наблюдения\nс контрдоказательствами",fillcolor="#fff6e9",color="#d6b479"];
    Facts -> Experts; Experts -> Pair; Experts -> Direct; Pair -> Global; Direct -> Global;
    Static -> Global; Static -> Legacy; Global -> Final -> Arbiter -> Recheck -> Verify; Legacy -> Verify;
    Arbiter -> Quarantine [label="не считать defect"];
  }
  Register -> Static; Register -> Facts; Register -> Legacy [label="legacy"];
  subgraph cluster_refs { label="REFERENCE RAG (ОПЦ.)"; style="rounded"; color="#9b83cb"; fontname="DejaVu Sans"; fontsize=12; labelloc=t;
    Index [shape=cylinder,label="Chroma · выбранные версии\nИзоляция владельца + хеш"];
    Hybrid [label="Vector + BM25 + RRF\nDrex reranking (опц.)"];
    RefVerify [label="Нормативное сравнение RF-ID\nДвойная проверка цитат",fillcolor="#fff6e9",color="#d6b479"];
    Index -> Hybrid -> RefVerify;
  }
  Register -> Index [label="если выбраны"];
  Drex [label="Независимый Nace Drex (опц.)\nD-ID и отдельно RF-ID",fillcolor="#fff6e9",color="#d6b479"];
  Verify -> Drex; RefVerify -> Drex;
  EvGraph [label="Evidence Graph (мультиагентные маршруты)\nИсходные наблюдения, цитаты, решения",fillcolor="#eae1fb",color="#8e70c6"];
  Verify -> EvGraph; Quarantine -> EvGraph;
  Verdict [label="Программный вердикт + статистика",fillcolor="#eae1fb",color="#8e70c6"];
  Report [label="Валидированный JSON / Markdown",fillcolor="#eae1fb",color="#8e70c6"];
  Verify -> Verdict; Verdict -> Report; EvGraph -> Report; Drex -> Report [style=dashed,label="отдельная оценка"]; RefVerify -> Report [style=dashed,label="RF-ID отдельно"];
  Archive [shape=cylinder,label="Web: PostgreSQL archive\nИсточник + проверенный отчёт",fillcolor="#eef6f0",color="#88b29a"];
  Export [label="CLI / экспорт Markdown и JSON"];
  UI [label="Отчёт · граф · чат · правки"];
  Report -> Archive -> UI; Report -> Export;
}
